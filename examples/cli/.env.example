# Copy to .env in this directory (examples/cli/.env).
LITE_AGENT_MODEL_ID=claude-sonnet-4-6
LITE_AGENT_MODEL_API_KEY=sk-...
LITE_AGENT_BASE_URL=https://api.anthropic.com
# Optional: force the protocol. Otherwise inferred from the model id
# (claude*/anthropic* -> anthropic, else openai).
# LITE_AGENT_MODEL_PROTOCOL=anthropic

# Optional reasoning and child profiles (same provider/endpoint as above).
# Set only for models supporting reasoning_effort (OpenAI-compatible) or
# adaptive thinking + output_config.effort (Anthropic). Unsupported models reject it.
# LITE_AGENT_REASONING_EFFORT=medium
# LITE_AGENT_SIMPLE_MODEL_ID=your-fast-model
# LITE_AGENT_SIMPLE_REASONING_EFFORT=low
# LITE_AGENT_COMPLEX_MODEL_ID=your-strong-model
# LITE_AGENT_COMPLEX_REASONING_EFFORT=high
